# ============================================================
# PUBLICIDAD (AdMob) — variables de entorno
# ------------------------------------------------------------
# Copiar a .env.production (o .env.qa) y completar con los IDs reales de
# AdMob antes de un build de producción. NUNCA commitear el archivo con
# valores reales — ver .gitignore. En desarrollo/QA (VITE_ADS_ENV distinto
# de "production") estas variables se IGNORAN por completo: siempre se usan
# los IDs de prueba oficiales de Google, hardcodeados a propósito en
# src/game/config/ads.config.js (no son un secreto).
# ============================================================

# "development" | "qa" | "production" — controla si se usan IDs de prueba o reales.
VITE_ADS_ENV=development

# Interruptor de emergencia — "false" desactiva TODA la publicidad sin romper el juego.
VITE_ADS_ENABLED=true

# --- Solo hacen falta si VITE_ADS_ENV=production ---
VITE_ADMOB_APP_ID_ANDROID=
VITE_ADMOB_UNIT_BATTLE_REVIVE=
VITE_ADMOB_UNIT_POST_BATTLE_GOLD_BONUS=
VITE_ADMOB_UNIT_DAILY_AD_CHEST=
# Fase 2 (todavía desactivados en PLACEMENT_CONFIG — no hace falta completarlos aún)
VITE_ADMOB_UNIT_DAILY_SECOND_CHANCE=
VITE_ADMOB_UNIT_BLACKSMITH_TIME_REDUCTION=
VITE_ADMOB_UNIT_EXPLORATION_BONUS=
VITE_ADMOB_UNIT_CONTRACT_BONUS=

# Dispositivos de prueba (UMP + AdMob testingDevices) — IDs de dispositivo, separados por coma.
VITE_ADS_TEST_DEVICE_IDS=

# Solo para probar el formulario de consentimiento europeo desde fuera de la UE — "EEA" o "NOT_EEA".
VITE_ADS_UMP_DEBUG_GEOGRAPHY=

# ------------------------------------------------------------
# NOTA: el AdMob App ID en sí (distinto de las unidades de arriba) se lee del
# lado NATIVO, no de Vite — es una variable de entorno normal del sistema/CI
# (sin prefijo VITE_) leída por android/app/build.gradle en el momento del
# build de Gradle, nunca desde este archivo:
#
#   ADMOB_APP_ID_ANDROID=ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY
#
# Sin esa variable, el build cae al ID de prueba oficial de Google (ver
# android/app/build.gradle) — nunca a un ID de producción real por accidente.
# ------------------------------------------------------------
